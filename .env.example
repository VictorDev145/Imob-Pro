NODE_ENV=development
PORT=3000
SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Acesso administrativo inicial / recuperação local
ADMIN_EMAIL=admin@imobpro.local
ADMIN_PASSWORD=admin123
# Em produção, deixe false. Só use true quando quiser sincronizar a senha definida no ambiente.
ADMIN_SYNC_PASSWORD=false
# Chave para recuperação administrativa local. Troque em produção se habilitar a rota.
ADMIN_RECOVERY_KEY=imobpro-local-recovery
ADMIN_RECOVERY_ENABLED=false

APP_URL=http://localhost:3000

SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Imob Pro <no-reply@seudominio.com>

# Opcional: caminho absoluto para preservar um banco existente fora da pasta do projeto.
# DB_PATH=/caminho/para/imobpro.sqlite